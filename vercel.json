{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/r/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/r/(.*\\.(?:ico|png|jpg|jpeg|gif|svg|webp|avif|woff|woff2|ttf|eot))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/r/locations/:path*",
      "missing": [
        {
          "type": "header",
          "key": "rsc"
        }
      ],
      "headers": [
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/r/building/:path*",
      "missing": [
        {
          "type": "header",
          "key": "rsc"
        }
      ],
      "headers": [
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "max-age=300, stale-while-revalidate=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/r/:path*",
      "destination": "/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/r",
      "destination": "https://precondo.ca/r/",
      "permanent": true
    },
    {
      "source": "/r//",
      "destination": "https://precondo.ca/r/",
      "permanent": true
    }
  ]
}
